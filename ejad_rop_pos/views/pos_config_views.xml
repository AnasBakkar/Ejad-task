<odoo>
    <record id="pos_config_rop_form" model="ir.ui.view">
        <field name="name">pos.config.rop.form</field><field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='title']" position="after">
                <group string="Ejad Cash now"><field name="ejad_cash_partner_id"/></group>
            </xpath>
        </field>
    </record>
</odoo>
