<odoo>
    <record id="product_template_rop_form" model="ir.ui.view">
        <field name="name">product.template.rop.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_same_rop_products" type="object" class="oe_stat_button" icon="fa-cubes" invisible="not has_rop">
                    <field name="same_rop_product_count" widget="statinfo" string="Same ROP"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="has_rop"/>
                <field name="rop_count" invisible="not has_rop"/>
            </xpath>
        </field>
    </record>
    <record id="action_rop_products" model="ir.actions.act_window">
        <field name="name">ROP Products</field><field name="res_model">product.template</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="domain">[('type', '=', 'product'), ('qty_available', '&lt;', 5)]</field>
    </record>
    <record id="action_above_rop_products" model="ir.actions.act_window">
        <field name="name">Products &gt; ROP</field><field name="res_model">product.template</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="domain">[('type', '=', 'product'), ('qty_available', '&gt;', 5)]</field>
    </record>
    <menuitem id="menu_rop" name="ROP" parent="stock.menu_stock_root" sequence="5" groups="stock.group_stock_user"/>
    <menuitem id="menu_rop_products" parent="menu_rop" action="action_rop_products" sequence="1"/>
    <menuitem id="menu_above_rop_products" parent="menu_rop" action="action_above_rop_products" sequence="2"/>
</odoo>
